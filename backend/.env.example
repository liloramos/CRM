APP_NAME=ChatBotCRM
APP_ENV=local
# Produção: APP_ENV=production e APP_DEBUG=false.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção HTTPS: SESSION_SECURE_COOKIE=true e SESSION_SAME_SITE=lax ou conforme o domínio.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_CA_BUNDLE=
WHATSAPP_FFMPEG_BINARY=ffmpeg
WHATSAPP_FFPROBE_BINARY=ffprobe
DEMO_DATA_ENABLED=false
# Aliases META_WHATSAPP_* antigos continuam aceitos apenas para compatibilidade.
FAKE_WHATSAPP_VERIFY_TOKEN=

AI_PROVIDER=fake
AI_AUTOMATION_ENABLED=true
AI_ALLOW_AUTO_SEND=false
AI_COPILOT_PROVIDER=fake
AI_COPILOT_ACT_SAFE_ENABLED=false
AI_COPILOT_DEFAULT_ROLLOUT=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
N8N_WEBHOOK_BASE_URL=
N8N_AI_WEBHOOK_PATH=

PRINTING_PROVIDER=browser

# O fallback mock é uma variável de build do frontend. Em produção, mantenha
# VITE_ENABLE_MOCK_FALLBACK ausente ou false.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Delivery Maps: mantenha a chave de servidor somente no backend e restrinja-a
# às APIs Geocoding/Routes. A chave pública do navegador deve ter restrição de referrer.
DELIVERY_MAPS_PROVIDER=fake
DELIVERY_GOOGLE_SERVER_API_KEY=
DELIVERY_GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
DELIVERY_GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
DELIVERY_MAPS_TIMEOUT_SECONDS=8
